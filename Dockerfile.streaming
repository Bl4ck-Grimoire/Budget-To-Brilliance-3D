# Image for the streaming services (init, consumer, producer).
# As in the Airflow image, the repository is NOT copied: docker-compose mounts it at /app,
# so editing src/streaming does not require rebuilding.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app
WORKDIR /app

COPY requirements-streaming.txt /requirements-streaming.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /requirements-streaming.txt
