DATABASE_URL=mysql+pymysql://root:changeme@localhost:3306/icfes_dw
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=icfes_dw

AIRFLOW_UID=50000

ICFES_SOURCE_DIR=data/source/icfes

MEN_API_URL=https://www.datos.gov.co/resource/ji8i-4anb.json
MEN_API_PAGE_SIZE=1000

MEN_MIN_YEAR_EXCLUSIVE=2021
COLEGIO_ATTR_POLICY=first
DUPLICATE_CONFLICT_POLICY=block

# Kafka: containers use kafka:29092 (set by docker-compose); programs run from your machine use localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RESULTS=saber11.resultados.v1
KAFKA_TOPIC_DLQ=saber11.resultados.dlq.v1
KAFKA_CONSUMER_GROUP=btb-stream-metrics

# Consumer micro-batches and time-series bucket
STREAM_MAX_BATCH=200
STREAM_FLUSH_SECONDS=1
STREAM_BUCKET_SECONDS=10
STREAM_REFERENCE_REFRESH_SECONDS=300

# Read-only MySQL account created by stream-init and used ONLY by Grafana
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=grafana_ro_local
# Grafana UI login (local use; change it if the port is ever exposed)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
